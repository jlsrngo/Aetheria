{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical Line Art Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["midnight-gold", "blueprint-cyan", "archival-ink", "obsidian-silver", "atelier-emerald"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["monoline-hero", "blueprint-split", "schematic-stack", "dimension-stat", "drafting-grid", "atelier-cta"] },
          "theme": { "enum": ["midnight-gold", "blueprint-cyan", "archival-ink", "obsidian-silver", "atelier-emerald"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 48 },
          "subtext": { "type": "string", "maxLength": 96 },
          "metric": { "type": "string" },
          "schematic": { "enum": ["blueprint-arch", "botanical-sprout", "circuit-trace", "compass-rose", "gear-schematic", "monogram-emblem"] },
          "transition": { "enum": ["pen-trace", "blueprint-fold", "cursor-sweep"] },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string" },
                "schematic": { "enum": ["blueprint-arch", "botanical-sprout", "circuit-trace", "compass-rose", "gear-schematic", "monogram-emblem"] }
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
