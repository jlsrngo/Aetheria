{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mg-line-art story.json schema",
  "type": "object",
  "required": [
    "shots",
    "canvas",
    "captions"
  ],
  "properties": {
    "aspect": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "fps": {
      "type": "integer",
      "default": 30
    },
    "seed": {
      "type": "integer",
      "default": 202
    },
    "microstockMode": {
      "type": "boolean",
      "default": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "start",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "seed-sprout",
              "pavilion-skyline",
              "breaking-wave",
              "atelier-medallion"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "headline": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "camera": {
            "type": "object",
            "properties": {
              "style": {
                "type": "string",
                "enum": [
                  "calm",
                  "kinetic",
                  "editorial"
                ]
              },
              "move": {
                "type": "string",
                "enum": [
                  "hold",
                  "push-in",
                  "pull-out",
                  "truck",
                  "pan",
                  "tilt",
                  "orbit",
                  "crane",
                  "handheld",
                  "whip-pan",
                  "rack-focus-in"
                ]
              },
              "dir": {
                "type": "string",
                "enum": [
                  "auto",
                  "left",
                  "right",
                  "up",
                  "down",
                  "in",
                  "out",
                  "cw",
                  "ccw",
                  "none"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "moveDuration": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0.1
                  },
                  {
                    "type": "string",
                    "enum": [
                      "shot",
                      "burst"
                    ]
                  }
                ]
              },
              "curve": {
                "type": "string",
                "enum": [
                  "linear",
                  "ease-out",
                  "ease-in-out",
                  "whip-out",
                  "whip-inout",
                  "spring"
                ]
              },
              "seed": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "w",
        "h",
        "fps"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "h": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "duration",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cameraStyle": {
      "type": "string",
      "enum": [
        "calm",
        "kinetic",
        "editorial"
      ]
    }
  }
}
