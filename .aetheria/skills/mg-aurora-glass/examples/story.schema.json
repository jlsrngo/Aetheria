{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aurora Glass Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["indigo-aurora", "emerald-northern", "rose-nebula", "obsidian-cyan", "twilight-violet"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["glass-hero", "glass-split", "glass-stack", "glass-metric", "glass-lens", "glass-cta"] },
          "theme": { "enum": ["indigo-aurora", "emerald-northern", "rose-nebula", "obsidian-cyan", "twilight-violet"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 48 },
          "subtext": { "type": "string", "maxLength": 96 },
          "metric": { "type": "string" },
          "widget": { "enum": ["orb-pulse", "waveform", "chat-bubble", "toggle-grid", "metric-ring", "spark-prism"] },
          "transition": { "enum": ["light-sweep", "luminance-fade", "prism-expand"] },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "widget": { "enum": ["orb-pulse", "waveform", "chat-bubble", "toggle-grid", "metric-ring", "spark-prism"] }
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
