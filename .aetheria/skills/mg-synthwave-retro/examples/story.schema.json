{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthwave Retro 1986 Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["outrun-1986", "miami-vice", "laser-crimson", "midnight-chrome", "vapor-teal"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["synth-hero", "synth-split", "synth-stack", "synth-stat", "synth-horizon", "synth-cta"] },
          "theme": { "enum": ["outrun-1986", "miami-vice", "laser-crimson", "midnight-chrome", "vapor-teal"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 42 },
          "subtext": { "type": "string", "maxLength": 88 },
          "metric": { "type": "string" },
          "icon": { "enum": ["retro-sun", "cassette-tape", "neon-palm", "sport-car", "laser-grid", "vhs-play"] },
          "transition": { "enum": ["vhs-rewind", "neon-flash", "grid-warp"] },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string" },
                "icon": { "enum": ["retro-sun", "cassette-tape", "neon-palm", "sport-car", "laser-grid", "vhs-play"] }
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
