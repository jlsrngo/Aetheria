{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthwave Outrun 1986 Story",
  "type": "object",
  "required": [
    "version",
    "shots",
    "canvas",
    "captions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "headline",
          "start",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "enum": [
              "highway-cruise",
              "chrome-slam",
              "neon-metric",
              "car-chase",
              "palm-sunset",
              "vhs-outro"
            ]
          },
          "theme": {
            "enum": [
              "outrun-1986",
              "miami-vice",
              "laser-crimson",
              "midnight-chrome",
              "vapor-teal"
            ]
          },
          "carMode": {
            "enum": [
              "cruising",
              "boost",
              "hidden"
            ]
          },
          "badge": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 32
          },
          "subtext": {
            "type": "string",
            "maxLength": 72
          },
          "metric": {
            "type": "string"
          },
          "transition": {
            "enum": [
              "vhs-rewind",
              "neon-flash",
              "grid-warp"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "duration",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "w",
        "h",
        "fps"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "h": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        }
      }
    }
  }
}
