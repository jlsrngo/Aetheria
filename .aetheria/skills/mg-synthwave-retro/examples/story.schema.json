{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthwave Outrun 1986 Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["outrun-1986", "miami-vice", "laser-crimson", "midnight-chrome", "vapor-teal"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["highway-cruise", "chrome-slam", "neon-metric", "car-chase", "palm-sunset", "vhs-outro"] },
          "theme": { "enum": ["outrun-1986", "miami-vice", "laser-crimson", "midnight-chrome", "vapor-teal"] },
          "carMode": { "enum": ["cruising", "boost", "hidden"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 32 },
          "subtext": { "type": "string", "maxLength": 72 },
          "metric": { "type": "string" },
          "transition": { "enum": ["vhs-rewind", "neon-flash", "grid-warp"] }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
