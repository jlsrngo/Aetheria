{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bauhaus Konstruktion Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["cream-1919", "weimar-ochre", "dessau-dark", "swiss-red", "zurich-mono"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["kandinsky-assembly", "escapement-pivot", "tile-cascade", "flip-matrix", "constructivist-stat", "bauhaus-poster"] },
          "theme": { "enum": ["cream-1919", "weimar-ochre", "dessau-dark", "swiss-red", "zurich-mono"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 36 },
          "subtext": { "type": "string", "maxLength": 84 },
          "metric": { "type": "string" },
          "verticalWord": { "type": "string" },
          "transition": { "enum": ["block-wipe", "tile-flip", "invert-cut"] }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
