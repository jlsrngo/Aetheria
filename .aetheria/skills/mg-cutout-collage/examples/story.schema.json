{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.local/schemas/mg-cutout-collage/story.schema.json",
  "title": "Aetheria 2D Cutout Collage Declarative Story Spec",
  "type": "object",
  "required": ["renderer", "canvas", "shots", "captions"],
  "additionalProperties": false,
  "properties": {
    "renderer": { "const": "2d-cutout-collage" },
    "title": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "enum": ["kraft", "newsprint", "corkboard", "charcoal", "scrapbook"] },
    "seed": { "type": "integer" },
    "cameraStyle": { "type": "string", "enum": ["calm", "kinetic", "editorial"] },
    "canvas": {
      "type": "object",
      "required": ["w", "h", "fps"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "h": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "fps": { "type": "integer", "minimum": 12, "maximum": 60 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration", "layout"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "layout": {
            "type": "string",
            "enum": ["dossier-hero", "split-compare", "evidence-board", "stat-callout", "timeline-strip", "quote-scrap"]
          },
          "paper": { "type": "string", "enum": ["kraft", "newsprint", "corkboard", "charcoal", "scrapbook"] },
          "header": { "type": "string" },
          "stamp": { "type": "string" },
          "cutout": {
            "type": "string",
            "enum": ["portrait", "brain", "globe", "rocket", "eye", "hand-point", "rose", "clock", "gear", "megaphone", "book", "coin", "chart", "lightbulb", "phone", "camera"]
          },
          "image": { "type": "string" },
          "headline": { "type": "string" },
          "subheadline": { "type": "string" },
          "quote": { "type": "string" },
          "statValue": { "type": "string" },
          "statLabel": { "type": "string" },
          "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "secondaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "accents": {
            "type": "array",
            "maxItems": 2,
            "items": { "type": "string", "enum": ["rose", "manicule", "gear", "wax-seal", "star", "arrow", "paperclip", "scissors"] }
          },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tag": { "type": "string" },
                "label": { "type": "string" },
                "cutout": {
                  "type": "string",
                  "enum": ["portrait", "brain", "globe", "rocket", "eye", "hand-point", "rose", "clock", "gear", "megaphone", "book", "coin", "chart", "lightbulb", "phone", "camera"]
                }
              }
            }
          },
          "transition": { "type": "string", "enum": ["tear-wipe", "cut"] },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "style": { "type": "string", "enum": ["calm", "kinetic", "editorial"] },
              "move": { "type": "string", "enum": ["hold", "push-in", "pull-out", "truck", "pan", "tilt", "orbit", "crane", "handheld", "whip-pan", "rack-focus-in"] },
              "dir": { "type": "string", "enum": ["auto", "left", "right", "up", "down", "in", "out", "cw", "ccw", "none"] },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
              "moveDuration": { "oneOf": [{ "type": "number", "minimum": 0.1 }, { "type": "string", "enum": ["shot", "burst"] }] },
              "curve": { "type": "string", "enum": ["linear", "ease-out", "ease-in-out", "whip-out", "whip-inout", "spring"] },
              "seed": { "type": "integer" }
            }
          },
          "caption": { "type": "string" },
          "audio": { "$ref": "#/$defs/audioRef" },
          "custom": { "type": "string", "pattern": "^script/[A-Za-z0-9_.-]+\\.js$" }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "audio": { "$ref": "#/$defs/audioRef" }
  },
  "$defs": {
    "audioRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "wav": { "type": "string" }, "words": { "type": "string" } }
    }
  }
}
