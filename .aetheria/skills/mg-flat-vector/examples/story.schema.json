{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mg-flat-vector story.json schema",
  "type": "object",
  "required": [
    "shots",
    "canvas",
    "captions"
  ],
  "properties": {
    "aspect": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "fps": {
      "type": "integer",
      "default": 30
    },
    "seed": {
      "type": "integer",
      "default": 101
    },
    "microstockMode": {
      "type": "boolean",
      "default": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "start",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "sky-dot-bounce",
              "city-pop-rise",
              "character-ping",
              "popwise-wordmark"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "headline": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "w",
        "h",
        "fps"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "h": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "duration",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
