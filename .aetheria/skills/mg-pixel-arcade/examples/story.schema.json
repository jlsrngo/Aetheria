{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixel Arcade 16-Bit Indexed Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["day", "afternoon", "golden", "sunset", "dusk", "night"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["side-scroll", "boss-encounter", "treasure-reveal", "title-logo", "dialogue-cutscene", "stage-clear"] },
          "theme": { "enum": ["day", "afternoon", "golden", "sunset", "dusk", "night"] },
          "heroAction": { "enum": ["run", "jump", "bop", "cheer", "item-get", "idle"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 32 },
          "subtext": { "type": "string", "maxLength": 80 },
          "score": { "type": "integer", "minimum": 0 },
          "coins": { "type": "integer", "minimum": 0 },
          "metric": { "type": "string" },
          "transition": { "enum": ["pixel-dissolve", "palette-shift", "crt-flash"] }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
