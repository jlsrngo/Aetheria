{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixel Arcade 16-Bit Indexed Story",
  "type": "object",
  "required": [
    "version",
    "shots",
    "canvas",
    "captions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "headline",
          "start",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "enum": [
              "side-scroll",
              "boss-encounter",
              "treasure-reveal",
              "title-logo",
              "dialogue-cutscene",
              "stage-clear"
            ]
          },
          "theme": {
            "enum": [
              "day",
              "afternoon",
              "golden",
              "sunset",
              "dusk",
              "night"
            ]
          },
          "heroAction": {
            "enum": [
              "run",
              "jump",
              "bop",
              "cheer",
              "item-get",
              "idle"
            ]
          },
          "badge": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 32
          },
          "subtext": {
            "type": "string",
            "maxLength": 80
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "coins": {
            "type": "integer",
            "minimum": 0
          },
          "metric": {
            "type": "string"
          },
          "transition": {
            "enum": [
              "pixel-dissolve",
              "palette-shift",
              "crt-flash"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "duration",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "w",
        "h",
        "fps"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "h": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        }
      }
    }
  }
}
