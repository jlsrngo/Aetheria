{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aetheria Stickman Story Schema",
  "type": "object",
  "required": ["shots"],
  "properties": {
    "renderer": { "const": "2d-stickman-story" },
    "title": { "type": "string" },
    "canvas": {
      "type": "object",
      "properties": {
        "w": { "type": "integer", "enum": [1080, 1920] },
        "h": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "default": 30 }
      }
    },
    "actorsMap": { "type": "object", "additionalProperties": { "type": ["string", "object"] } },
    "captions": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "stage": {
            "type": "string",
            "enum": ["bedroom", "park", "classroom", "study", "living-room", "street", "school-yard", "cafeteria", "field", "house-front", "dining-room", "meadow", "plain"]
          },
          "timeOfDay": { "type": "string", "enum": ["morning", "day", "sunset", "night"] },
          "caption": { "type": "string" },
          "actors": { "type": "array" },
          "camera": { "type": "object" },
          "props": { "type": "array" },
          "bubbles": { "type": "array" },
          "overlays": { "type": "array" },
          "fx": { "type": "array" },
          "transition": { "type": ["string", "object"] }
        }
      }
    }
  }
}
