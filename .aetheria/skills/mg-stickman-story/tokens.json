{
  "skillId": "mg-stickman-story",
  "version": "1.0.0",
  "description": "Warm pastel 2.5D comic storytelling palette, bold outline weights, and Fredoka/Nunito rounded typography tokens.",
  "colors": {
    "outlineInk": "#181A20",
    "paperWarm": "#FFF3E2",
    "paperCard": "#FFF9F0",
    "skinPeach": "#FAD7B8",
    "skinFair": "#FDE0C6",
    "afroTeal": "#4A7A7C",
    "nadiaTaupe": "#D7B38C",
    "coralRed": "#FF5A4E",
    "sunnyGold": "#FFD60A",
    "parkGreen": "#6BCB77",
    "skyBlue": "#72C8FF",
    "nightNavy": "#1B264F"
  },
  "typography": {
    "display": "Fredoka, Nunito, Segoe UI, sans-serif",
    "subtitleSize": 46,
    "comicBurstSize": 118
  },
  "camera": {
    "defaultAspect": "9:16",
    "defaultWidth": 1080,
    "defaultHeight": 1920,
    "livingHold": true,
    "creep": 0.05,
    "followLagSec": 0.5,
    "shotSizes": {
      "extreme-wide": 0.56,
      "wide": 0.86,
      "full": 1.25,
      "medium": 1.9,
      "close": 3.0,
      "extreme-close": 5.2
    },
    "transitionDefaults": {
      "cut": 0.0,
      "fade": 0.35,
      "flash": 0.28,
      "whip": 0.38,
      "slide-push": 0.42,
      "iris": 0.48,
      "zoom-cross": 0.45,
      "blink": 0.32
    },
    "recipes": {
      "hookInsert": "close -> fly-to full",
      "alarmShock": "shake + fly-to",
      "realizationAha": "punch + snap-zoom",
      "runningEntrance": "follow -> push two-shot",
      "banter": "orbit-sway + push",
      "panic": "dutch + shake",
      "calmFocus": "rack-focus + slow push",
      "comicRecap": "grid[2,2] + zoom"
    }
  },
  "music": {
    "defaultVolume": 0.18,
    "duck": true,
    "loudnormLufs": -16,
    "moods": {
      "cheerful": { "bpm": 122, "feel": "bright bouncy ukulele-style plucks" },
      "chill": { "bpm": 88, "feel": "warm Rhodes chords & soft pulse" },
      "tense": { "bpm": 105, "feel": "low suspense drone & clock tick" },
      "comic": { "bpm": 132, "feel": "playful pizzicato & staccato bass" },
      "sad": { "bpm": 76, "feel": "sparse minor piano pad" },
      "epic": { "bpm": 116, "feel": "wide fifth strings & sub pulse" },
      "study": { "bpm": 92, "feel": "steady minimal lofi harmonic loop" },
      "mystery": { "bpm": 96, "feel": "detuned chime & minor fifth pad" },
      "warm": { "bpm": 100, "feel": "golden major-7th acoustic progression" }
    }
  }
}
