{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mg-cel-boil story.json schema",
  "type": "object",
  "required": ["aspect", "fps", "shots"],
  "properties": {
    "aspect": { "type": "string", "enum": ["9:16", "16:9"] },
    "fps": { "type": "integer", "default": 24 },
    "seed": { "type": "integer", "default": 505 },
    "microstockMode": { "type": "boolean", "default": false },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layout", "start", "duration"],
        "properties": {
          "id": { "type": "string" },
          "layout": {
            "type": "string",
            "enum": ["strike-smear", "spirit-jump", "box-dance", "badge-riffle"]
          },
          "start": { "type": "number" },
          "duration": { "type": "number" },
          "exposure": { "type": "string", "enum": ["on-1s", "on-2s", "on-3s"] },
          "drawingNumber": { "type": "integer" },
          "sceneCode": { "type": "string" },
          "headline": { "type": "string" },
          "subheadline": { "type": "string" },
          "tagline": { "type": "string" },
          "spiritFace": {
            "type": "string",
            "enum": ["open", "happy", "wink", "fierce", "squeeze"]
          }
        }
      }
    }
  }
}
