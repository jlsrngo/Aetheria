{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.local/schemas/mg-soft-clay-story/story.schema.json",
  "title": "Aetheria Soft-Clay Declarative Story Spec",
  "type": "object",
  "required": ["canvas", "cast", "props", "shots", "captions"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "object",
      "required": ["w", "h", "fps"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "h": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "fps": { "type": "integer", "minimum": 12, "maximum": 60 }
      }
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actorEntry" }
    },
    "props": {
      "type": "array",
      "items": { "$ref": "#/$defs/actorEntry" }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration", "focus", "camera", "stage", "actions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "focus": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            ]
          },
          "camera": {
            "type": "object",
            "required": ["preset"],
            "additionalProperties": false,
            "properties": {
              "preset": { "type": "string", "enum": ["wide", "medium", "close", "dolly-in", "orbit"] }
            }
          },
          "stage": { "type": "string", "enum": ["city-street", "open-field", "indoor-room"] },
          "mood": { "type": "string", "enum": ["day", "sunset", "night"] },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "anim", "at", "dur"],
              "additionalProperties": false,
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "anim": {
                  "type": "string",
                  "enum": ["idle", "walk", "run", "hop", "grow", "pop-in", "wave", "talk", "point", "cheer", "shock", "work", "nod", "dance"]
                },
                "at": { "type": "number", "minimum": 0 },
                "dur": { "type": "number", "exclusiveMinimum": 0 },
                "from": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                "to": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                "faceMove": { "type": "boolean" },
                "expression": { "$ref": "#/$defs/expression" },
                "emote": { "$ref": "#/$defs/emote" }
              }
            }
          },
          "placements": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pos": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                "rotY": { "type": "number" },
                "visible": { "type": "boolean" },
                "expression": { "$ref": "#/$defs/expression" },
                "emote": { "$ref": "#/$defs/emote" }
              }
            }
          },
          "caption": { "type": "string" },
          "audio": { "$ref": "#/$defs/audioRef" },
          "custom": { "type": "string", "pattern": "^script/[A-Za-z0-9_.-]+\\.js$" }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "audio": { "$ref": "#/$defs/audioRef" }
  },
  "$defs": {
    "assetSpec": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["humanoid", "flower-row", "container", "insect", "tree", "building", "vehicle", "blob"]
        },
        "variant": {
          "type": "string",
          "enum": ["adult", "kid", "elder", "chubby", "shop", "house", "hut", "barn", "apartment", "school"]
        },
        "hair": {
          "type": "string",
          "enum": ["short", "long", "bun", "ponytail", "spiky", "bald"]
        },
        "palette": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "scale": { "type": "number", "exclusiveMinimum": 0.1, "maximum": 10 },
        "accessories": {
          "type": "array",
          "items": { "type": "string", "enum": ["hat-conical", "hat-cap", "towel", "glasses", "backpack", "beard", "hijab"] }
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actorEntry": {
      "type": "object",
      "required": ["id", "asset"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "asset": { "$ref": "#/$defs/assetSpec" },
        "pos": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "rotY": { "type": "number" },
        "visible": { "type": "boolean" },
        "expression": { "$ref": "#/$defs/expression" },
        "emote": { "$ref": "#/$defs/emote" }
      }
    },
    "expression": {
      "type": "string",
      "enum": ["happy", "laugh", "sad", "surprised", "angry", "worried", "sleepy"]
    },
    "emote": {
      "type": "string",
      "enum": ["", "exclaim", "question", "idea", "heart", "sweat", "anger", "sleep", "music"]
    },
    "audioRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wav": { "type": "string" },
        "words": { "type": "string" }
      }
    }
  }
}
