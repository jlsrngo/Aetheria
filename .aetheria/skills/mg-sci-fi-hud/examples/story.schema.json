{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sci-Fi Kestrel-9 FUI HUD Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["cyber-cyan", "alert-amber", "crimson-lock", "stealth-emerald", "orbital-violet"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["scope-search", "signal-detected", "target-locked", "orbital-dive", "spectrum-analysis", "uplink-complete"] },
          "theme": { "enum": ["cyber-cyan", "alert-amber", "crimson-lock", "stealth-emerald", "orbital-violet"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 38 },
          "subtext": { "type": "string", "maxLength": 88 },
          "metric": { "type": "string" },
          "coords": { "type": "string" },
          "rangeKm": { "type": "number" },
          "transition": { "enum": ["glitch-cut", "shockwave-lock", "scan-wipe"] }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
