{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sci-Fi FUI HUD Story",
  "type": "object",
  "required": ["version", "meta", "shots"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "width", "height", "fps", "durationSec", "theme"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer", "enum": [1080, 1920] },
        "height": { "type": "integer", "enum": [1920, 1080] },
        "fps": { "type": "integer", "const": 30 },
        "durationSec": { "type": "number", "minimum": 3, "maximum": 90 },
        "theme": { "enum": ["cyber-cyan", "alert-amber", "stealth-emerald", "orbital-violet", "crimson-lock"] }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "layout", "headline"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0.5 },
          "layout": { "enum": ["hud-hero", "hud-split", "hud-telemetry", "hud-lock", "hud-matrix", "hud-cta"] },
          "theme": { "enum": ["cyber-cyan", "alert-amber", "stealth-emerald", "orbital-violet", "crimson-lock"] },
          "badge": { "type": "string" },
          "headline": { "type": "string", "maxLength": 44 },
          "subtext": { "type": "string", "maxLength": 92 },
          "metric": { "type": "string" },
          "module": { "enum": ["radar-sweep", "target-reticle", "wire-globe", "signal-wave", "hex-core", "orbital-rings"] },
          "transition": { "enum": ["glitch-cut", "scan-wipe", "lock-snap"] },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string" },
                "module": { "enum": ["radar-sweep", "target-reticle", "wire-globe", "signal-wave", "hex-core", "orbital-rings"] }
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec", "text"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
