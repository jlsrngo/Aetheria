{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sci-Fi Kestrel-9 FUI HUD Story",
  "type": "object",
  "required": [
    "version",
    "shots",
    "canvas",
    "captions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "headline",
          "start",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "enum": [
              "scope-search",
              "signal-detected",
              "target-locked",
              "orbital-dive",
              "spectrum-analysis",
              "uplink-complete"
            ]
          },
          "theme": {
            "enum": [
              "cyber-cyan",
              "alert-amber",
              "crimson-lock",
              "stealth-emerald",
              "orbital-violet"
            ]
          },
          "badge": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 38
          },
          "subtext": {
            "type": "string",
            "maxLength": 88
          },
          "metric": {
            "type": "string"
          },
          "coords": {
            "type": "string"
          },
          "rangeKm": {
            "type": "number"
          },
          "transition": {
            "enum": [
              "glitch-cut",
              "shockwave-lock",
              "scan-wipe"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "duration",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "w",
        "h",
        "fps"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "h": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        }
      }
    }
  }
}
