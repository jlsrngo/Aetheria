{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mg-3d-spatial story.json schema",
  "type": "object",
  "required": ["aspect", "fps", "shots"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" },
        "durationSec": { "type": "number" }
      }
    },
    "aspect": { "type": "string", "enum": ["9:16", "16:9"] },
    "fps": { "type": "integer", "default": 24 },
    "seed": { "type": "integer", "default": 404 },
    "microstockMode": { "type": "boolean", "default": false },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layout", "start", "duration"],
        "properties": {
          "id": { "type": "string" },
          "layout": {
            "type": "string",
            "enum": ["capsule-bed-drop", "letter-cascade", "sphere-shockwave", "soft-finale"]
          },
          "start": { "type": "number" },
          "duration": { "type": "number" },
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "headline": { "type": "string" },
          "tagline": { "type": "string" }
        }
      }
    }
  }
}
